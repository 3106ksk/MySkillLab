<%# locals: (evaluation:, rank:) %>

<section class="evaluation-panel result-panel" aria-labelledby="effort-title">
  <h2 id="effort-title" class="evaluation-panel-head">
    <span class="evaluation-panel-label">
      <span class="evaluation-panel-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><circle cx="12" cy="12" r=".6"/></svg>
      </span>
      <%= t(".title") %>
    </span>
  </h2>

  <dl class="result-rows">
    <div class="result-row">
      <dt class="result-key"><%= t("evaluation_result.axes.start") %></dt>
      <dd class="result-value"><%= t("evaluation_result.start_label") %></dd>
    </div>

    <div class="result-row">
      <dt class="result-key"><%= t("evaluation_result.axes.focus") %></dt>
      <dd class="result-value">
        <%= evaluation.focus_option.label %>
        <% if evaluation.focus_option.description.present? %>
          <small class="result-note"><%= evaluation.focus_option.description %></small>
        <% end %>
      </dd>
    </div>

    <div class="result-row">
      <dt class="result-key"><%= t("evaluation_result.axes.challenge") %></dt>
      <dd class="result-value">
        <%= evaluation.challenge_option.label %>
        <% if evaluation.challenge_option.description.present? %>
          <small class="result-note"><%= evaluation.challenge_option.description %></small>
        <% end %>
      </dd>
    </div>
  </dl>

  <p class="result-reason"><%= t("rank.reasons.#{rank}") %></p>
</section>
