<% content_for :title, @study_record.activity %>

<div class="evaluation evaluation-result">
  <h1 class="evaluation-result-title"><%= @study_record.activity %></h1>

  <div class="evaluation-result-stamp">
    <%= render "shared/rank_stamp", rank: @study_record.rank, size_class: "stamp-size-l" %>
  </div>

  <%= render "shared/study_record_summary", study_record: @study_record %>
  <%= render "shared/evaluation_breakdown", evaluation: @evaluation, rank: @study_record.rank %>
  <%= render "shared/insight_summary", insights: @study_record.insights %>

  <div class="evaluation-actions">
    <%= link_to t(".actions.study_again"), new_study_record_path, class: "btn btn-primary" %>
  </div>
</div>
